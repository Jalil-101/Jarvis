# Anthropic (required for chat / tools)
ANTHROPIC_API_KEY=

# Optional overrides
# JARVIS_MODEL=claude-sonnet-5
# JARVIS_MAX_TOKENS=2048
# JARVIS_DATA_DIR=data
# JARVIS_DB_PATH=jarvis.db
# JARVIS_AUDIT_LOG=audit.jsonl
# JARVIS_TTS_VOICE=en-GB-RyanNeural
# JARVIS_PORT=8787
# JARVIS_API_TOKEN=

# Voice — ElevenLabs for premium British TTS (leave blank to keep edge-tts)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Force free Microsoft edge-tts instead: JARVIS_TTS_PROVIDER=edge-tts
# Mic device index from `.\scripts\run.cmd mic-test` if default is silent:
# JARVIS_MIC_DEVICE=9
# STT speed vs accuracy: tiny.en (fast) | base | small.en (clearer, slower)
# JARVIS_STT_MODEL=tiny.en
OPENAI_API_KEY=

# Official Google APIs (Phase 7) — never commit the JSON files
# GMAIL_CREDENTIALS_FILE=
# GOOGLE_CALENDAR_CREDENTIALS_FILE=
